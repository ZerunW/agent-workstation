{
  "name": "@agent-workstation/status",
  "version": "0.1.0",
  "private": true,
  "description": "workstation-status: metrics collector, health checks and status page for the Agent Workstation server",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "dev": "tsx watch src/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "demo": "WORKSTATION_STATUS_DEMO=1 tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-workstation/protocol": "0.1.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "pino": "^10.1.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "uplot": "^1.6.32",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
