{
  "name": "@agent-workstation/hub",
  "version": "0.1.0",
  "private": true,
  "description": "workstation-hub: personal remote coding workstation backend (sessions, files, terminal, usage) for Agent Workstation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "WORKSTATION_CONFIG=${WORKSTATION_CONFIG:-../../config/workstation.toml} tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.4",
    "@agent-workstation/browser": "0.1.0",
    "@agent-workstation/protocol": "0.1.0",
    "@agent-workstation/sync-core": "0.1.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "fastify": "^5.12.7",
    "node-pty": "^1.1.0",
    "pino": "^10.1.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
