<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AgentWorkstation.app (main process): App Sandbox. Network client for the hub and its web app;
     read-only access to what the person picks (NSOpenPanel / drag and drop), kept across launches
     with read-only app-scoped bookmarks; read-write Downloads for page downloads. Nothing else
     file-related: the main process cannot write into linked folders. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.files.user-selected.read-only</key><true/>
  <key>com.apple.security.files.bookmarks.app-scope</key><true/>
  <key>com.apple.security.files.downloads.read-write</key><true/>
</dict>
</plist>
